# Copy to .env (never committed) to deploy from your machine. In GitHub
# Actions the same names come from the "production" environment instead.

# Cloudflare account, and an API token for it (see the README for permissions).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Your Intuit app's keys: Development keys with QBO_ENVIRONMENT=sandbox,
# Production keys with QBO_ENVIRONMENT=production.
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# Intuit logins allowed to connect, comma-separated. Required.
ALLOWED_EMAILS=you@example.com
# QuickBooks company IDs allowed, comma-separated. Empty allows any company.
ALLOWED_REALM_IDS=

# Write tools. Off unless set to true.
ALLOW_CREATE=false
ALLOW_UPDATE=false
ALLOW_DELETE=false

# Named on the privacy policy and terms pages. Required.
OPERATOR_NAME=Example Co
OPERATOR_CONTACT=https://example.com

# Optional: serve on a custom domain in this Cloudflare account instead of
# workers.dev, and fix the Worker's script name.
# QBO_DOMAIN=qbo.example.com
# WORKER_NAME=qbo-mcp
